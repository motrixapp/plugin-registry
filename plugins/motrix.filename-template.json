{
  "id": "motrix.filename-template",
  "name": {
    "en": "Motrix Filename Template",
    "zh": "Motrix 文件名模板"
  },
  "description": {
    "en": "Renames downloaded files using a template ({{title}}, {{ext}}, {{date}}, {{id}}) before they are finalized.",
    "zh": "在完成下载前按模板（{{title}}、{{ext}}、{{date}}、{{id}}）重命名文件。"
