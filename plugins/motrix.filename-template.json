{
  "id": "motrix.filename-template",
  "listing": {
    "defaultLocale": "en-US",
    "localizations": {
      "en-US": {
        "name": "Motrix Filename Template",
        "description": "Renames downloaded files using a template ({{title}}, {{ext}}, {{date}}, {{id}}) before they are finalized.",
        "features": [
          "Renames finished downloads from a configurable template",
          "Placeholders: {{title}}, {{ext}}, {{date}}, {{id}}",
          "Works with HTTP, FTP and BitTorrent downloads",
          "Applies before the file is finalized on disk"
        ]
      },
      "zh-CN": {
        "name": "Motrix 文件名模板",
        "description": "在完成下载前按模板（{{title}}、{{ext}}、{{date}}、{{id}}）重命名文件。",
        "features": [
          "按可配置模板重命名已完成的下载",
          "支持占位符：{{title}}、{{ext}}、{{date}}、{{id}}",
          "支持 HTTP、FTP 与 BitTorrent 下载",
          "在文件最终落盘前执行"
        ]
      }
    }
  },
